{
  "version": 1,
  "author": "kelvyn andrade",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "env": "micropython-20231227-v1.22.0" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": -100,
      "left": 200,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 100,
      "left": 220,
      "attrs": { "color": "red" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    ["esp:3V3", "ldr1:VCC", "red", []],
    ["esp:GND.1", "ldr1:GND", "black", []],
    ["ldr1:AO", "esp:34", "green", []],

    ["esp:GND.2", "btn1:1.l", "black", []],
    ["btn1:2.l", "esp:4", "yellow", []]
  ],
  "dependencies": {}
}